[Unit]
Description=Telegram-бот мониторинга сервера
After=network-online.target docker.service
Wants=network-online.target
OnFailure=srvbot-fail.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 -m srvbot
Restart=always
RestartSec=10
MemoryMax=300M
Environment=PYTHONUNBUFFERED=1
# меньше арен glibc — меньше памяти оседает после картинок, которые рисуются в потоках
Environment=MALLOC_ARENA_MAX=2

[Install]
WantedBy=multi-user.target
