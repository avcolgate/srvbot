# Настройки бота для этого сервера. Установщик (install.sh) создаёт файл /etc/srvbot.env сам
# и спрашивает значения. После ручной правки: sudo systemctl restart srvbot

# Токен бота — у @BotFather в Telegram (/newbot).
BOT_TOKEN=1234567890:AAAA-ваш-токен
# Ваш числовой Telegram ID — узнать у @userinfobot. Бот отвечает только этому пользователю.
OWNER_ID=123456789
# Проверка доступности сервера из страны через check-host.net (двухбуквенный код ISO).
# Пусто — проверки нет. Примеры: de (Германия), fr (Франция), nl (Нидерланды), us (США)
CHECK_COUNTRY=

# --- Тонкая настройка: обычно не нужна, всё определяется автоматически ---
# Раскомментируйте строку, чтобы переопределить.

# Часовой пояс для сводок. По умолчанию — часовой пояс сервера.
#TIMEZONE=Europe/Paris

# Туннель ищется сам: контейнер, где есть утилита с именем интерфейса (xyz0 -> xyz) и командой
# «show all dump»; список клиентов — файл, в котором встречается ключ клиента.
# Если автоопределение не сработало, задайте вручную:
#TUNNEL_MATCH=my-tunnel                  # подстрока имени или образа контейнера
#TUNNEL_TOOLS=tunctl                     # утилита внутри контейнера
#TUNNEL_CLIENTS=/etc/tunnel/clients.json # JSON-список клиентов: [{"publicKey": "…", "name": "laptop"}]

# Дополнительные процессы, чьи порты контролировать (sshd, nginx, docker-proxy — всегда).
#PORT_PROCESSES=caddy,postgres
